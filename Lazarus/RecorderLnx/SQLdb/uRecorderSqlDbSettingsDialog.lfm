    end
    object edSignalSearch: TEdit
      Left = 58
      Height = 27
      Top = 63
      Width = 388
      OnChange = edSignalSearchChange
      TabOrder = 1
    end
    object lvSignals: TListView
      Left = 8
      Height = 284
      Top = 98
      Width = 438
      Checkboxes = True
      Columns = <
        item
          Caption = 'Тег / канал'
          Width = 270
        end
        item
          Caption = 'Оценка (пишем в SQL)'
          Width = 150
        end>
      MultiSelect = True
