      TabOrder = 3
    end
    object btnAssignEstimate: TButton
      Left = 314
      Height = 30
      Top = 386
      Width = 132
      Caption = 'Назначить'
      OnClick = btnAssignEstimateClick
      TabOrder = 4
    end
    object btnSelectAll: TButton
      Left = 8
      Height = 30
      Top = 444
      Width = 210
      Caption = 'Выбрать все'
      OnClick = btnSelectAllClick
      TabOrder = 5
    end
    object btnSelectNone: TButton
      Left = 236
      Height = 30
      Top = 444
      Width = 210
      Caption = 'Снять все'
      OnClick = btnSelectNoneClick
      TabOrder = 6
    end
  end
  object btnOk: TButton Left = 916 Height = 34 Top = 560 Width = 90 Caption = 'OK' Default = True OnClick = btnOkClick TabOrder = 4 end
  object btnCancel: TButton Left = 1016 Height = 34 Top = 560 Width = 90 Cancel = True Caption = 'Отмена' ModalResult = 2 TabOrder = 5 end
end
