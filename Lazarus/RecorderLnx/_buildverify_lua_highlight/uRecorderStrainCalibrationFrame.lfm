  object lblOutput: TLabel Left = 354 Top = 86 Caption = 'Результат' end
  object cbOutputUnit: TComboBox Left = 442 Height = 25 Top = 82 Width = 180 Style = csDropDownList end
  object lblExcitationKind: TLabel Left = 8 Top = 128 Caption = 'Тип питания' end
  object cbExcitationKind: TComboBox Left = 172 Height = 25 Top = 124 Width = 140 Style = csDropDownList OnChange = cbExcitationKindChange end
