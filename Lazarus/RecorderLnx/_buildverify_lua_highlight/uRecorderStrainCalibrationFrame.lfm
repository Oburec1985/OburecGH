  object edGaugeFactor: TEdit Left = 482 Height = 25 Top = 164 Width = 140 end
  object lblResistance: TLabel Left = 8 Top = 208 Caption = 'Сопротивление R0, Ом' end
  object edResistance: TEdit Left = 172 Height = 25 Top = 204 Width = 140 end
  object lblYoung: TLabel Left = 326 Top = 208 Caption = 'Модуль Юнга, МПа' end
  object edYoung: TEdit Left = 482 Height = 25 Top = 204 Width = 140 end
  object lblTcr: TLabel Left = 8 Top = 248 Caption = 'ТКСО датчика, 1/°C' end
  object edTcr: TEdit Left = 172 Height = 25 Top = 244 Width = 140 end
  object lblDeltaT: TLabel Left = 326 Top = 248 Caption = 'Изменение T, °C' end
  object edDeltaT: TEdit Left = 482 Height = 25 Top = 244 Width = 140 end
  object lblMax: TLabel Left = 8 Top = 288 Caption = 'Диапазон ±, мкстр' end
  object edMaxStrain: TEdit Left = 172 Height = 25 Top = 284 Width = 140 end
