object RecorderStrainCalibrationDialog: TRecorderStrainCalibrationDialog
  Left = 400
  Height = 560
  Top = 180
  Width = 650
  BorderStyle = bsDialog
  Caption = 'Тензометрическая градуировка'
  ClientHeight = 560
  ClientWidth = 650
  OnCreate = FormCreate
  Position = poOwnerFormCenter
  object lblName: TLabel Left = 16 Top = 18 Caption = 'Наименование' end
  object edName: TEdit Left = 180 Height = 25 Top = 14 Width = 440 end
  object lblScheme: TLabel Left = 16 Top = 56 Caption = 'Схема включения' end
  object cbScheme: TComboBox Left = 180 Height = 25 Top = 52 Width = 440 Style = csDropDownList end
  object lblInput: TLabel Left = 16 Top = 94 Caption = 'Входные единицы' end
  object cbInputUnit: TComboBox Left = 180 Height = 25 Top = 90 Width = 170 Style = csDropDownList end
  object lblOutput: TLabel Left = 366 Top = 94 Caption = 'Результат' end
  object cbOutputUnit: TComboBox Left = 450 Height = 25 Top = 90 Width = 170 Style = csDropDownList end
  object lblExcitationKind: TLabel Left = 16 Top = 136 Caption = 'Тип питания' end
  object cbExcitationKind: TComboBox Left = 180 Height = 25 Top = 132 Width = 140 Style = csDropDownList OnChange = cbExcitationKindChange end
  object lblExcitation: TLabel Left = 336 Top = 136 Caption = 'Напряжение, В' end
  object edExcitation: TEdit Left = 480 Height = 25 Top = 132 Width = 140 end
  object lblPoisson: TLabel Left = 16 Top = 176 Caption = 'Коэффициент Пуассона' end
  object edPoisson: TEdit Left = 180 Height = 25 Top = 172 Width = 140 end
  object lblGauge: TLabel Left = 336 Top = 176 Caption = 'Коэффициент S' end
  object edGaugeFactor: TEdit Left = 480 Height = 25 Top = 172 Width = 140 end
  object lblResistance: TLabel Left = 16 Top = 216 Caption = 'Сопротивление R0, Ом' end
  object edResistance: TEdit Left = 180 Height = 25 Top = 212 Width = 140 end
  object lblYoung: TLabel Left = 336 Top = 216 Caption = 'Модуль Юнга, МПа' end
  object edYoung: TEdit Left = 480 Height = 25 Top = 212 Width = 140 end
  object lblTcr: TLabel Left = 16 Top = 256 Caption = 'ТКСО датчика, 1/°C' end
  object edTcr: TEdit Left = 180 Height = 25 Top = 252 Width = 140 end
  object lblDeltaT: TLabel Left = 336 Top = 256 Caption = 'Изменение T, °C' end
  object edDeltaT: TEdit Left = 480 Height = 25 Top = 252 Width = 140 end
  object lblMax: TLabel Left = 16 Top = 296 Caption = 'Диапазон ±, мкстр' end
  object edMaxStrain: TEdit Left = 180 Height = 25 Top = 292 Width = 140 end
  object lblExpansion: TLabel Left = 336 Top = 296 Caption = 'ТКЛР детали, 1/°C' end
  object edExpansion: TEdit Left = 480 Height = 25 Top = 292 Width = 140 end
  object gbResult: TGroupBox Left = 16 Height = 130 Top = 342 Width = 604 Caption = 'Скомпилированная формула runtime'
    object lblCoefficients: TLabel Left = 16 Top = 34 Width = 570 Caption = 'y = Offset + K1·x + K2·x²' end
    object lblError: TLabel Left = 16 Top = 70 Width = 570 Caption = 'Допустимая ошибка: не более 0,1%' end
  end
  object btnOk: TButton Left = 432 Height = 30 Top = 510 Width = 90 Caption = 'OK' Default = True OnClick = btnOkClick end
  object btnCancel: TButton Left = 530 Height = 30 Top = 510 Width = 90 Caption = 'Отмена' Cancel = True ModalResult = 2 end
end
