#!/usr/bin/env bash
set -eu

fail() { printf '%s\n' "$1" >&2; exit 1; }

target_user() {
  local candidate
  if [ -n "${PKEXEC_UID:-}" ]; then
    candidate="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
  else
    candidate="${SUDO_USER:-user}"
  fi
  test -n "$candidate" || fail "Не удалось определить пользователя рабочего стола."
  printf '%s' "$candidate"
}

safe_extension() {
  local extension
  extension="${1##*.}"
  test "$extension" != "$1" || fail "У выбранного файла нет расширения."
  extension="$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')"
  case "$extension" in
    ''|*[!a-z0-9_-]*) fail "Расширение должно содержать латинские буквы, цифры, дефис или подчёркивание." ;;
  esac
  printf '%s' "$extension"
}

install_handler() {
  local extension="$1" program="$2" mime_type desktop_id launcher quoted_program
  mime_type="application/x-recorderlnx-$extension"
  desktop_id="recorderlnx-open-$extension.desktop"
  launcher="/usr/local/bin/recorderlnx-open-$extension"
  printf -v quoted_program '%q' "$program"
  printf '#!/usr/bin/env bash\nexec %s "$@"\n' "$quoted_program" > "$launcher"
  chmod 0755 "$launcher"
  cat > "/usr/share/mime/packages/recorderlnx-$extension.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="$mime_type">
    <comment>$extension file</comment>
    <glob pattern="*.$extension" weight="100"/>
  </mime-type>
</mime-info>
EOF
  cat > "/usr/share/applications/$desktop_id" <<EOF
[Desktop Entry]
Type=Application
Name=$(basename "$program")
Exec=$launcher %f
Terminal=false
MimeType=$mime_type;
NoDisplay=true
Categories=Utility;
EOF
  update-mime-database /usr/share/mime >/dev/null
  update-desktop-database /usr/share/applications >/dev/null
  printf '%s\n%s\n' "$mime_type" "$desktop_id"
}

set_user_default() {
  local user_name="$1" mime_type="$2" desktop_id="$3" user_home user_group
  user_home="$(getent passwd "$user_name" | cut -d: -f6)"
  user_group="$(id -gn "$user_name")"
  install -d -o "$user_name" -g "$user_group" "$user_home/.config"
  runuser -u "$user_name" -- env HOME="$user_home" \
    XDG_CONFIG_HOME="$user_home/.config" \
    xdg-mime default "$desktop_id" "$mime_type"
}

main() {
  local sample_file program extension handler_info mime_type desktop_id user_name
  test "$(id -u)" -eq 0 || fail "Запустите утилиту через pkexec или sudo."
  test "$#" -eq 2 || fail "Использование: recorderlnx-associate-file ФАЙЛ ПРОГРАММА"
  sample_file="$1"
  program="$2"
  test -f "$sample_file" || fail "Файл-пример не найден: $sample_file"
  test -x "$program" || fail "Программа не найдена или не исполняемая: $program"
  extension="$(safe_extension "$sample_file")"
  handler_info="$(install_handler "$extension" "$program")"
  mime_type="$(printf '%s\n' "$handler_info" | sed -n '1p')"
  desktop_id="$(printf '%s\n' "$handler_info" | sed -n '2p')"
  user_name="$(target_user)"
  set_user_default "$user_name" "$mime_type" "$desktop_id"
  printf '*.%s -> %s (%s)\n' "$extension" "$program" "$user_name"
}

main "$@"
