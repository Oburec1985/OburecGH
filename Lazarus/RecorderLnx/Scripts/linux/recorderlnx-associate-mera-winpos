#!/usr/bin/env bash
set -eu

readonly MIME_TYPE="application/x-mera-measurement"
readonly DESKTOP_ID="recorderlnx-winpos.desktop"
readonly MIME_PACKAGE="/usr/share/mime/packages/recorderlnx-mera.xml"
readonly DESKTOP_FILE="/usr/share/applications/$DESKTOP_ID"
readonly LAUNCHER="/usr/local/bin/recorderlnx-open-mera-winpos"

fail() { printf '%s\n' "$1" >&2; exit 1; }

target_user() {
  local candidate
  if [ -n "${PKEXEC_UID:-}" ]; then
    candidate="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
  else
    candidate="${SUDO_USER:-user}"
  fi
  test -n "$candidate" || fail "Не удалось определить пользователя рабочего стола."
  printf '%s' "$candidate"
}

install_launcher() {
  cat > "$LAUNCHER" <<'EOF'
#!/usr/bin/env bash
set -eu
wine_prefix="$HOME/.wine"
winpos_dir="$wine_prefix/drive_c/Program Files (x86)/Mera/WinPOS"
winpos="$winpos_dir/WinPos.exe"

show_error() {
  printf '%s\n' "$1" >&2
  command -v zenity >/dev/null 2>&1 && zenity --error --text="$1" || true
  exit 1
}

if [ ! -f "$winpos" ]; then
  winpos="$(find "$wine_prefix/drive_c/Program Files (x86)" -maxdepth 4 \
    -type f -iname 'WinPos.exe' -print -quit 2>/dev/null || true)"
  test -n "$winpos" || show_error "WinPOS не найден в $wine_prefix"
  winpos_dir="$(dirname "$winpos")"
fi

cd "$winpos_dir" || show_error "Не удалось открыть рабочий каталог WinPOS: $winpos_dir"
test "$#" -gt 0 || {
  exec env WINEPREFIX="$wine_prefix" wine "$winpos"
}
test -f "$1" || show_error "Файл замера не найден: $1"
windows_file="$(env WINEPREFIX="$wine_prefix" winepath -w "$1")" || \
  show_error "Wine не смог преобразовать путь к файлу: $1"
exec env WINEPREFIX="$wine_prefix" wine "$winpos" "$windows_file"
EOF
  chmod 0755 "$LAUNCHER"
}

install_mime_type() {
  cat > "$MIME_PACKAGE" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-mera-measurement">
    <comment>MERA measurement</comment>
    <comment xml:lang="ru">Замер MERA</comment>
    <glob pattern="*.mera" weight="100"/>
  </mime-type>
</mime-info>
EOF
  update-mime-database /usr/share/mime
}

install_desktop_entry() {
  cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=WinPOS
Comment=Open MERA measurement in WinPOS through Wine
Exec=$LAUNCHER %f
Icon=wine
Terminal=false
MimeType=$MIME_TYPE;application/x-wine-extension-mera;
NoDisplay=true
Categories=Science;Utility;
EOF
  chmod 0644 "$DESKTOP_FILE"
  update-desktop-database /usr/share/applications
}

set_user_default() {
  local user_name="$1" user_home user_group
  user_home="$(getent passwd "$user_name" | cut -d: -f6)"
  user_group="$(id -gn "$user_name")"
  test -n "$user_home" || fail "Не найден домашний каталог пользователя $user_name."
  install -d -o "$user_name" -g "$user_group" "$user_home/.config"
  runuser -u "$user_name" -- env HOME="$user_home" \
    XDG_CONFIG_HOME="$user_home/.config" \
    xdg-mime default "$DESKTOP_ID" "$MIME_TYPE"
  runuser -u "$user_name" -- env HOME="$user_home" \
    XDG_CONFIG_HOME="$user_home/.config" \
    xdg-mime default "$DESKTOP_ID" application/x-wine-extension-mera
}

main() {
  local user_name
  test "$(id -u)" -eq 0 || fail "Запустите утилиту через pkexec или sudo."
  command -v wine >/dev/null 2>&1 || fail "Не установлена команда wine."
  command -v xdg-mime >/dev/null 2>&1 || fail "Не установлен пакет xdg-utils."
  command -v update-mime-database >/dev/null 2>&1 || \
    fail "Не установлен пакет shared-mime-info."
  user_name="$(target_user)"
  install_launcher
  install_mime_type
  install_desktop_entry
  set_user_default "$user_name"
  printf '.mera -> %s (%s)\n' "$DESKTOP_ID" "$user_name"
}

main "$@"
