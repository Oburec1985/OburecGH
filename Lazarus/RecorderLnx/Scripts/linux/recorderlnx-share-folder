#!/usr/bin/env bash
set -eu

readonly MANAGER_CLI="/opt/mera/RecorderLnx/LinuxSetupManagerCli"

if [ "$(id -u)" -ne 0 ]; then
  exec pkexec "$0" "$@"
fi

if [ ! -x "$MANAGER_CLI" ]; then
  printf 'Не установлен LinuxSetupManagerCli: %s\n' "$MANAGER_CLI" >&2
  exit 1
fi

# Единственный механизм публикации находится во встроенном Pascal-коде.
# Он сохраняет valid users и режим ro/rw существующего управляемого ресурса.
exec "$MANAGER_CLI" --internal publish "$@"
