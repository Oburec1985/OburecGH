  object lblMinX: TLabel Left = 16 Height = 15 Top = 176 Width = 42 Caption = 'X min:' end
  object edMinX: TEdit Left = 72 Height = 27 Top = 170 Width = 96 end
  object lblMaxX: TLabel Left = 184 Height = 15 Top = 176 Width = 45 Caption = 'X max:' end
  object edMaxX: TEdit Left = 240 Height = 27 Top = 170 Width = 96 end
