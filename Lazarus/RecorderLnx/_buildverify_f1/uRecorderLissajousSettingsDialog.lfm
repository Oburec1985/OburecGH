  object cbXTag: TComboBox Left = 136 Height = 27 Top = 50 Width = 368 Anchors = [akTop, akLeft, akRight] Style = csDropDownList end
  object lblYTag: TLabel Left = 16 Height = 15 Top = 96 Width = 40 Caption = 'Тег Y:' end
  object cbYTag: TComboBox Left = 136 Height = 27 Top = 90 Width = 368 Anchors = [akTop, akLeft, akRight] Style = csDropDownList end
  object lblDuration: TLabel Left = 16 Height = 15 Top = 136 Width = 110 Caption = 'Длина участка, с:' end
