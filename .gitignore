# RecorderLnx build and package products. Keep the scripts, control files,
# resources and Debian source tree; only generated outputs stay local.
/installer/RecorderLnx/linux/Output/
/Lazarus/RecorderLnx/linux_build*.log
/Lazarus/RecorderLnx/linux_build_report.txt
