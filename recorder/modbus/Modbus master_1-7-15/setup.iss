; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "plugin Modbus Master"
#define MyAppVersion "1.7.15.0"
#define MyAppExeName "plgModbusMaster.dll"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{918258ED-168A-4703-8134-BFE2343A6B4C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
DefaultDirName=C:\Program Files (x86)\Mera\Recorder\plugins
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=.\distrib
OutputBaseFilename=setup_plgModbus_{#MyAppVersion}
SetupIconFile=.\icons\adept_installer_4275.ico
; Password=sintez1234
Compression=lzma
SolidCompression=yes

[Languages]
Name: "en"; MessagesFile: "compiler:default.isl"
Name: "ru"; MessagesFile: "compiler:Languages\Russian.isl"

[Files]
Source: "C:\Program Files (x86)\Mera\Recorder\plugins\plgModbusMaster.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\languages\plgModbusMaster.en.po"; DestDir: "C:\Mera Files\Modbus lang"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: ".\languages\plgModbusMaster.ru.po"; DestDir: "C:\Mera Files\Modbus lang"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files


