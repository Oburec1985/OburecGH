Функция plm_ПодборЭлементовПоСвойствам( мсЗначенияСвойств ) Экспорт
	Если мсЗначенияСвойств.Количество() = 0 Тогда 
		ВозвМассив = Новый Массив;
		Возврат ВозвМассив; 
	КонецЕсли;
	
	ЗапросЭлементов = Новый Запрос;
	ЗапросЭлементов.Текст = "ВЫБРАТЬ
	                        |	ЗначенияПараметров.ЭлементСсылка КАК ЭлементСсылка
	                        |ИЗ
	                        |	(ВЫБРАТЬ
	                        |		plm_ЭлементыСтруктурыПараметры.Ссылка КАК ЭлементСсылка,
	                        |		ВЫРАЗИТЬ(plm_ПараметрыЭлементов.Значение КАК СТРОКА(1024)) КАК ЗначениеПараметраСтрокой
	                        |	ИЗ
	                        |		Справочник.plm_ЭлементыСтруктуры КАК plm_ЭлементыСтруктуры
	                        |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.plm_ЭлементыСтруктуры.Параметры КАК plm_ЭлементыСтруктурыПараметры
	                        |			ПО plm_ЭлементыСтруктуры.Ссылка = plm_ЭлементыСтруктурыПараметры.Ссылка
	                        |				И (НЕ plm_ЭлементыСтруктуры.ПометкаУдаления)
	                        |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.plm_ПараметрыЭлементов КАК plm_ПараметрыЭлементов
	                        |			ПО (plm_ЭлементыСтруктурыПараметры.Параметр = plm_ПараметрыЭлементов.Ссылка)
	                        |				И (plm_ПараметрыЭлементов.Значение <> НЕОПРЕДЕЛЕНО)) КАК ЗначенияПараметров";
	Для j = 0 По мсЗначенияСвойств.ВГраница() Цикл 
		Если j = 0 Тогда 
			ЗапросЭлементов.Текст = ЗапросЭлементов.Текст + "
							|ГДЕ
							|	";
		Иначе
			ЗапросЭлементов.Текст = ЗапросЭлементов.Текст + "
							|	ИЛИ ";
		КонецЕсли;
		ЗапросЭлементов.Текст = ЗапросЭлементов.Текст + "ЗначениеПараметраСтрокой = ВЫРАЗИТЬ(&Значение" + Строка(j) + " КАК СТРОКА(1024))";
		ЗапросЭлементов.УстановитьПараметр("Значение" + Строка(j), мсЗначенияСвойств[j]);
	КонецЦикла;
	ЗапросЭлементов.Текст = ЗапросЭлементов.Текст + "
							|
							|СГРУППИРОВАТЬ ПО
							|	ЭлементСсылка
							|
							|ИМЕЮЩИЕ
							|	КОЛИЧЕСТВО(ЗначениеПараметраСтрокой) >= &КоличествоСвойств";
	ЗапросЭлементов.УстановитьПараметр("КоличествоСвойств", мсЗначенияСвойств.Количество());
	Возврат ЗапросЭлементов.Выполнить().Выгрузить();
КонецФункции

Функция РазборСтрокиТекстовогоДокумента( Знач Строка, СимволРазделитель ) Экспорт
	ВозвМассив=Новый Массив();
	Пока СтрДлина(Строка)>0 Цикл 
		i=Найти(Строка,СимволРазделитель);
		Знч=?(i>0, Лев(Строка,i-1), Строка);
		Знч=СтрЗаменить(Знч,"""","");
		ВозвМассив.Добавить(Знч);
		Строка=?(i>0, Сред(Строка,i+1), "");
	КонецЦикла;
	Возврат ВозвМассив;
КонецФункции

Процедура ПрочитатьДанныеBOM( ТабДок, ТДокумент, Прогресс, ПараметрыЧтения ) Экспорт
	ТабДок.Очистить();
	
	// уровень
	ОбластьКолонки = ТабДок.Область(0,1,0,1);
	ОбластьКолонки.ШиринаКолонки = 5;
	// вид элемента	
	ОбластьКолонки = ТабДок.Область(0,2,0,2);
	ОбластьКолонки.ШиринаКолонки = 20;
	
	//Прогресс.МаксимальноеЗначение=ТДокумент.КоличествоСтрок();
	//Прогресс.МинимальноеЗначение=1;
	
	Для i=1 По ТДокумент.КоличествоСтрок() Цикл
		//Прогресс.Значение=i;
		
		ЗаполнитьОбластьУровня(ТабДок.Область(i,1,i,1), 1);
		
		СтрокаТДокумента=ТДокумент.ПолучитьСтроку(i+ПараметрыЧтения.НачальныйНомерСтроки-1);
		
		МассивЗначений=РазборСтрокиТекстовогоДокумента(СтрокаТДокумента, ПараметрыЧтения.СимволРазделитель);
		Для j=1 По МассивЗначений.Количество() Цикл
			ОбластьЯчейки = ТабДок.Область(i,j+2,i,j+2);
			ОбластьЯчейки.Текст = МассивЗначений[j-1];
			
			ЗаполнитьОбласть(ТабДок.Область(i,2,i,2), Справочники.plm_ВидыЭлементов.ПустаяСсылка());
		КонецЦикла;
	КонецЦикла;
	
	//Прогресс.Значение=0;
КонецПроцедуры

Процедура ПрочитатьДанныеEXCEL( ТабДок, ExcelЛист, Прогресс, СтруктураНастроек ) Экспорт 
	ТабДок.Очистить();
	
	// уровень
	ОбластьКолонки = ТабДок.Область(0,1,0,1);
	ОбластьКолонки.ШиринаКолонки = 5;
	// вид элемента	
	ОбластьКолонки = ТабДок.Область(0,2,0,2);
	ОбластьКолонки.ШиринаКолонки = 20;
	
	xlCellTypeLastCell = 11;
	Rows = ExcelЛист.Cells.SpecialCells(xlCellTypeLastCell).Row;
	Cols = ExcelЛист.Cells.SpecialCells(xlCellTypeLastCell).Column;
	
	
	//Прогресс.МаксимальноеЗначение=Rows;
	//Прогресс.МинимальноеЗначение=1;
	текущийОтступ=1;
	Для i=1 По Rows Цикл 
		//Прогресс.Значение=i;
		outLineLevel=ExcelЛист.Rows(i).OutlineLevel;
		Если outLineLevel>текущийОтступ Тогда
			ТабДок.НачатьГруппуСтрок();
			текущийОтступ=outLineLevel;
		ИначеЕсли outLineLevel<текущийОтступ Тогда
			ТабДок.ЗакончитьГруппуСтрок();
    		текущийОтступ=outLineLevel;
		КонецЕсли;
		
        ЗаполнитьОбластьУровня(ТабДок.Область(i,1,i,1), текущийОтступ);

		Для j=1 По Cols Цикл 
			ОбластьКолонки = ТабДок.Область(0,j+2,0,j+2);
			ОбластьКолонки.ШиринаКолонки = ExcelЛист.Columns(j).ColumnWidth;
			ОбластьЯчейки = ТабДок.Область(i,j+2,i,j+2);
			ОбластьЯчейки.Текст = ExcelЛист.Cells(i,j).Value;
		КонецЦикла;
		ЗаполнитьОбласть(ТабДок.Область(i,2,i,2), Справочники.plm_ВидыЭлементов.ПустаяСсылка());
	КонецЦикла;
	
	//Прогресс.Значение=0;
КонецПроцедуры

Процедура ЗаписатьДанныеEXCEL(ТабДок, МассивСтрок) Экспорт
	ТабДок.Очистить();
	
	// уровень
	ОбластьКолонки = ТабДок.Область(0,1,0,1);
	ОбластьКолонки.ШиринаКолонки = 5;
	// вид элемента	
	ОбластьКолонки = ТабДок.Область(0,2,0,2);
	ОбластьКолонки.ШиринаКолонки = 20;
	
	текущийОтступ=1;
	Для i=1 По МассивСтрок.Количество() Цикл
		ТекСтрока = МассивСтрок[i-1];
		
		Если ТекСтрока.outLineLevel>текущийОтступ Тогда
			ТабДок.НачатьГруппуСтрок();
			текущийОтступ=ТекСтрока.outLineLevel;
		ИначеЕсли ТекСтрока.outLineLevel<текущийОтступ Тогда
			ТабДок.ЗакончитьГруппуСтрок();
			текущийОтступ=ТекСтрока.outLineLevel;
		КонецЕсли;
		
		ЗаполнитьОбластьУровня(ТабДок.Область(i,1,i,1), текущийОтступ);
		
		Для j=1 По ТекСтрока.Cols.Количество() Цикл
			ОбластьКолонки = ТабДок.Область(0,j+2,0,j+2);
			ОбластьКолонки.ШиринаКолонки = ТекСтрока.ColumnWidth[j-1];
			ОбластьЯчейки = ТабДок.Область(i,j+2,i,j+2);
			ОбластьЯчейки.Текст = ТекСтрока.Cols[j-1];
		КонецЦикла;
		
		ЗаполнитьОбласть(ТабДок.Область(i,2,i,2), ПредопределенноеЗначение("Справочник.plm_ВидыЭлементов.ПустаяСсылка"));
	КонецЦикла;
КонецПроцедуры

