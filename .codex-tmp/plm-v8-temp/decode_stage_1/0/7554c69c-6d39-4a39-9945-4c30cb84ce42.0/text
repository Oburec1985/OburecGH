			КонецЕсли;
			
			currentParentXDTO.modified=Истина;
		ИначеЕсли ФормаПриемник = Неопределено Тогда 
			Сообщить("Режим ""Импортировать в корень"" доступен с версией конфигурации Appius-PLM не ниже 2016.91!", СтатусСообщения.Важное);
			Прервать;
		Иначе 
			КорнСтрока = ФормаПриемник.ДеревоПредставления.Строки.Добавить();
			КорнСтрока.ЭлементСсылка	= itemXDTO.element;
			КорнСтрока.Картинка			= itemXDTO.pictureIndex;
			КорнСтрока.ОбъектXDTO		= itemXDTO;
			
			МассивКорнСтрок.Добавить(КорнСтрока);
		КонецЕсли; // Если currentParentXDTO <> Неопределено Тогда 
		
		plm_ОбновитьПредставлениеВМоделиXDTO(itemXDTO);
	КонецЦикла;
	
	Если ЗагружатьВКорень Тогда 
		Для Каждого КорнСтрока Из МассивКорнСтрок Цикл 
			Если КорнСтрока.ОбъектXDTO.items.Количество() > 0 Тогда 
				Обработки.plm_Проводник.plm_ОбновитьДеревоПоМоделиXDTOРек(КорнСтрока.ОбъектXDTO, КорнСтрока.Строки, ФормаПриемник.СтруктураПараметровОтображения);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗагружатьСоставИзделия Тогда  
		Обработки.plm_УправлениеСтруктуройИзделия.plm_ОформитьСпецификацию(parentXDTO);
	КонецЕсли;
	
КонецПроцедуры

// Процедура импортирует данные из внешнего источника в режиме рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO
//		ТаблицаИмпорта - ТаблицаЗначений, таблица данных импорта
//		ТаблицаКолонокРесурса - ТаблицаЗначений, таблица колонок ресурса
Процедура plm_ИмпортДанныхКТС( parentXDTO, ТаблицаИмпорта, ТаблицаКолонокРесурса, ФормаПриемник = Неопределено ) Экспорт 
	Если ТаблицаКолонокРесурса=Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ТаблицаКолонок=ТаблицаКолонокРесурса.Скопировать(новый Структура("Видимость",Истина));
	Если ТаблицаКолонок.Количество()=0 Тогда 
		Возврат;
	КонецЕсли;	
	МассивРодителей=Новый Массив();
	МассивРодителей.Добавить( parentXDTO );
	itemXDTO=Неопределено;
	ТекущийУровень=1;
	ВидЭлементовРесурса=plm_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO,ПланыВидовХарактеристик.plm_Свойства.ВидРесурса,Ложь );
	Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл 
		СтрокаИмпорта=ТаблицаИмпорта[i];
		ВидЭлементаИмпорта = СтрокаИмпорта.ВидЭлемента;
		Если ВидЭлементовРесурса<>ВидЭлементаИмпорта Тогда
			Продолжить;
		КонецЕсли;		
		Если ТипЗнч(ВидЭлементаИмпорта)<>Тип("СправочникСсылка.plm_ВидыЭлементов") Тогда 
			itemXDTO = plm_СоздатьОбъектМоделиXDTO(ВидЭлементаИмпорта);
		Иначе
			
			Попытка
				НачатьТранзакцию();
				СозданныйОбъект = Обработки.plm_СозданиеОбъектов.plm_СозданиеОбъекта(ВидЭлементаИмпорта, Новый ДеревоЗначений);
				// заполнение параметров элемента по параметрам ресурса
				Обработки.plm_КонструкторскоТехнологическийСправочник.plm_СоздатьНаборПараметровЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
				Если parentXDTO.element.ПредставлениеЭлементовРесурса.Количество() > 0 Тогда 
					// использовать представление ресурса
					Обработки.plm_КонструкторскоТехнологическийСправочник.plm_СоздатьПредставлениеЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
				Иначе 
					// использовать представление вида элемента
					Обработки.plm_СозданиеОбъектов.plm_СоздатьПредставление(СозданныйОбъект);
				КонецЕсли;
				
				/////////////////////////////////////////////////////
				// заполнение значений параметров по таблице (для элемента)
				Для Каждого СтрокаПараметра Из СозданныйОбъект.Параметры Цикл 
					МассивКолонокРесурса = ТаблицаКолонок.НайтиСтроки(Новый Структура("ИмяПараметра,Свойство", СтрокаПараметра.Параметр.Наименование,СтрокаПараметра.Параметр.Свойство));
					Если МассивКолонокРесурса.Количество() > 0 Тогда 
						КолонкаРесурса = МассивКолонокРесурса[0];
						ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаРесурса);
						Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
							ТипЗначенияСвойства = СтрокаПараметра.Параметр.Свойство.ТипЗначения;
							ЗначениеПараметра = plm_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
							//Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда 
							ОбъектПараметра = СтрокаПараметра.Параметр.ПолучитьОбъект();
							ОбъектПараметра.Значение = ЗначениеПараметра;
							ОбъектПараметра.Записать();
							//КонецЕсли;
						КонецЕсли;
					КонецЕсли; // Если КолонкаРесурса <> Неопределено Тогда 
				КонецЦикла;
				
				СозданныйОбъект.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
				СозданныйОбъект.Записать();
				itemXDTO = plm_СоздатьОбъектМоделиXDTO(СозданныйОбъект.Ссылка);
				itemXDTO.created = Истина;
				plm_ЗаполнитьПредставлениеМоделиПоТабЧасти(itemXDTO, СозданныйОбъект.ПредставлениеЭлемента);
				ОтменитьТранзакцию(); // отмена транзации после создания xdto-модели
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.plm_ПрефиксСлужебныхСообщений+НСтр("ru = ""Не удалось импортировать элемент:""; en_US = ""Cannot import the item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				Продолжить;
			КонецПопытки;						
		КонецЕсли;
	
					
		itemXDTO.linkType = СериализаторXDTO.ЗаписатьXDTO(Справочники.plm_ШаблоныТехнологическихСвязей.Ресурсы);
		
		//// оставшиеся параметры
		//Для Каждого КолонкаРесурса Из ТаблицаКолонок Цикл 
		//	Если НайденныеСвойства.Найти(КолонкаРесурса.Свойство)=Неопределено И ЗначениеЗаполнено(КолонкаРесурса.Свойство) Тогда 
		//		ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаРесурса);
		//		Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
		//			ТипЗначенияСвойства = КолонкаРесурса.Свойство.ТипЗначения;
		//			ЗначениеПараметра = plm_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
		//			//Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда 
		//			МодульСозданияПараметров.plm_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, КолонкаРесурса.Свойство, ЗначениеПараметра);
		//			//КонецЕсли;
		//		КонецЕсли;
		//	КонецЕсли;
		//КонецЦикла;
		
		itemXDTO.added	  =Истина;
		itemXDTO.modified =Истина;
		
		plm_ОбновитьПредставлениеВМоделиXDTO(itemXDTO);
		
		
		currentParentXDTO=МассивРодителей[МассивРодителей.Количество()-1];
		
		ПозДляВставки=Неопределено; // определить позицию для вставки объекта
		plm_НайтиВМассивеXDTO(currentParentXDTO.items, Новый Структура("refLinkGroup", Истина), ПозДляВставки);
		
		Если ПозДляВставки <> Неопределено Тогда 
			currentParentXDTO.items.Вставить(ПозДляВставки, itemXDTO);
			ПозДляВставки = ПозДляВставки + 1;
		Иначе 
			currentParentXDTO.items.Добавить(itemXDTO);
		КонецЕсли;
		
		currentParentXDTO.modified=Истина;
	КонецЦикла; // Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл
КонецПроцедуры



МассивТипов=Новый Массив();
МассивТипов.Добавить(Тип("СправочникСсылка.plm_ВидыЭлементов"));
МассивТипов.Добавить(Тип("СправочникСсылка.plm_ЭлементыСтруктуры"));
ОписаниеТиповЯчейки=Новый ОписаниеТипов(МассивТипов);

ОписаниеТиповЯчейкиУровня=Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный));


