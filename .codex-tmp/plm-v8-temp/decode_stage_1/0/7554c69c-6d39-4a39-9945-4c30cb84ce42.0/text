// Процедура импортирует данные из внешнего источника в режиме рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO
//		ТаблицаИмпорта - ТаблицаЗначений, таблица данных импорта
//		ТаблицаКолонокСпецификации - ТаблицаЗначений, таблица колонок спецификации
Процедура plm_ИмпортДанныхСпецификации( parentXDTO, ТаблицаИмпорта, ТаблицаКолонокСпецификации, ФормаПриемник = Неопределено ) Экспорт 
	ФлагПроверкиУникальности=(ПараметрыСеанса.plm_ПроверкаУникальностиВключена=Истина 
								И Константы.plm_ПроверкаУникальности.Получить()=Истина);

	
	ТаблицаКолонокСпецификации.Сортировать("ВидЭлемента");
	ТаблицаРазличныхВидов = ТаблицаКолонокСпецификации.Скопировать();
	ТаблицаРазличныхВидов.Свернуть("ВидЭлемента");
	МассивРазличныхВидов = ТаблицаРазличныхВидов.ВыгрузитьКолонку("ВидЭлемента");
	СоответствиеВидовИКолонок = Новый Соответствие;
	Для Каждого Видссылка Из МассивРазличныхВидов Цикл 
		СоответствиеВидовИКолонок.Вставить(Видссылка, ТаблицаКолонокСпецификации.Скопировать(Новый Структура("ВидЭлемента, Видимость", Видссылка, Истина)));
	КонецЦикла;
	
	
	//ТаблицаКолонок=ТаблицаКолонокСпецификации.Скопировать(Новый Структура("ВидЭлемента",parentXDTO.elementType));
	//Если ТаблицаКолонок.Количество()=0 Тогда 
	//	ТаблицаКолонок=ТаблицаКолонокСпецификации.Скопировать(Новый Структура("ВидЭлемента",Справочники.plm_ВидыЭлементов.ПустаяСсылка()));
	//КонецЕсли;
	//Если ТаблицаКолонок.Колонки.Найти("Видимость") <> Неопределено Тогда 
	//	j=0;
	//	Пока j<ТаблицаКолонок.Количество() Цикл 
	//		Если ТаблицаКолонок[j].Видимость<>Истина Тогда 
	//			ТаблицаКолонок.Удалить(j); Продолжить;
	//		КонецЕсли;
	//		j=j+1;
	//	КонецЦикла;
	//КонецЕсли;
	ПроверятьПринадлежностьСвойства = (ТаблицаКолонокСпецификации.Колонки.Найти("Принадлежность")<>Неопределено);
	НаличиеКолонокЕдиницИзмерения = (ТаблицаКолонокСпецификации.Колонки.Найти("ЕдиницыИзмерения")<>Неопределено И ТаблицаКолонокСпецификации.Найти(Истина,"ЕдиницыИзмерения")<>Неопределено);
	
	МассивРодителей=Новый Массив();
	МассивРодителей.Добавить( ?(ЗагружатьВКорень, Неопределено, parentXDTO) );
	
	МассивКорнСтрок = Новый Массив;
	
	СоответствиеСуществующихЭлементовИXDTO = Новый Соответствие;
	МассивНеобрабатываемыхРодителейXDTO = Новый Массив;
	
	ДеревоСвойствСвязиОбразец = plm_ПолучитьДеревоСвойств(Справочники.plm_ВидыЭлементов.СвязьСостава);
	СоответствиеВидовЭлементовИДеревьевСвойств = Новый Соответствие;
	
	СоответствиеВидовЭлементовИСтрокЗначений = Новый Соответствие;
	
	Если Метаданные.Справочники.Найти("УпаковкиЕдиницыИзмерения") <> Неопределено Тогда 
		ОписаниеТиповЕдИзм = Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения");
	Иначе 
		ОписаниеТиповЕдИзм = Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения");
	КонецЕсли;
	Если НЕ ЗагружатьСоставИзделия Тогда 
		// шаблоны тех. связей для поиска по видам элементов
		Запрос=Новый Запрос("ВЫБРАТЬ
		                    |	plm_ШаблоныТехнологическихСвязейВидыЭлементов.ВидЭлемента,
		                    |	plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов.ВидЭлемента КАК ВидЭлементаПотомок,
		                    |	plm_ШаблоныТехнологическихСвязейВидыЭлементов.Ссылка,
		                    |	plm_ШаблоныТехнологическихСвязейВидыЭлементов.Ссылка.ГоризонтальнаяСвязь КАК ГоризонтальнаяСвязь
		                    |ИЗ
		                    |	Справочник.plm_ШаблоныТехнологическихСвязей.ВидыЭлементов КАК plm_ШаблоныТехнологическихСвязейВидыЭлементов
		                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.plm_ШаблоныТехнологическихСвязей.ПодчиненныеВидыЭлементов КАК plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов
		                    |		ПО plm_ШаблоныТехнологическихСвязейВидыЭлементов.Ссылка = plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов.Ссылка
		                    |ГДЕ
		                    |	НЕ plm_ШаблоныТехнологическихСвязейВидыЭлементов.ВидЭлемента.ПометкаУдаления
		                    |	И НЕ plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов.ВидЭлемента.ПометкаУдаления
		                    |	И НЕ plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов.Ссылка.Служебный
		                    |	И НЕ plm_ШаблоныТехнологическихСвязейПодчиненныеВидыЭлементов.Ссылка.КонтекстнаяСвязь
		                    |
		                    |УПОРЯДОЧИТЬ ПО
		                    |	plm_ШаблоныТехнологическихСвязейВидыЭлементов.Ссылка.Код");
		ТЗВидовЭлементовИШаблоновСвязей=Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	МассивСообщений = Новый Массив;

	
	itemXDTO=Неопределено;
	ТекущийУровень=1;
	Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл 
		СтрокаИмпорта=ТаблицаИмпорта[i];
		Если СтрокаИмпорта.Уровень=0 Тогда 
			СтрокаИмпорта.Уровень=1;
		КонецЕсли;
		
		Если СтрокаИмпорта.Уровень>ТекущийУровень И i>0 Тогда
			МассивРодителей.Добавить( itemXDTO );
			ТекущийУровень=ТекущийУровень+1;
		ИначеЕсли СтрокаИмпорта.Уровень<ТекущийУровень Тогда
			РазницаУровней=ТекущийУровень-СтрокаИмпорта.Уровень;
			Для k=1 По РазницаУровней Цикл 
				МассивРодителей.Удалить(МассивРодителей.Количество()-1);
			КонецЦикла;
			ТекущийУровень=ТекущийУровень-РазницаУровней;
		КонецЕсли;
		
		currentParentXDTO=МассивРодителей[МассивРодителей.Количество()-1];
		Если МассивНеобрабатываемыхРодителейXDTO.Найти(currentParentXDTO)<>Неопределено Тогда 
			Продолжить; 
		КонецЕсли;
		
		ТаблицаКолонок = СоответствиеВидовИКолонок.Получить(?(currentParentXDTO=Неопределено, Справочники.plm_ВидыЭлементов.ПустаяСсылка(), currentParentXDTO.elementType));
		Если ТаблицаКолонок = Неопределено Тогда 
			ТаблицаКолонок = СоответствиеВидовИКолонок.Получить(Справочники.plm_ВидыЭлементов.ПустаяСсылка());
		КонецЕсли;
		
		
		// первая колонка всегда ВидЭлемента
		ВидЭлементаИмпорта = СтрокаИмпорта.ВидЭлемента; НайденныеСвойства = Новый Массив();
		
		Если ТипЗнч(ВидЭлементаИмпорта)<>Тип("СправочникСсылка.plm_ВидыЭлементов") Тогда 
			itemXDTO = plm_СоздатьОбъектМоделиXDTO(ВидЭлементаИмпорта);
		Иначе
			itemXDTO = Неопределено;
			
			ДеревоСвойствОбразец = СоответствиеВидовЭлементовИДеревьевСвойств[ВидЭлементаИмпорта];
			Если ДеревоСвойствОбразец = Неопределено Тогда 
				ДеревоСвойствОбразец = plm_ПолучитьДеревоСвойств(ВидЭлементаИмпорта);
